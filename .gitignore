# 依赖与构建产物
node_modules/
**/.vitepress/cache/
**/.vitepress/dist/

# 模型权重：一律不入库，用下载脚本或 Ollama/llama.cpp 自带缓存
models/
*.gguf
*.safetensors
*.bin
*.pth
*.pt

# 语料本体：公开资料也有版权，只提交 corpus/sources.yaml 与下载脚本
corpus/raw/
corpus/**/*.pdf
corpus/**/*.png
corpus/**/*.jpg
corpus/**/*.tif

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# 环境与编辑器
.env
.env.*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# 浏览器自动化（playwright MCP）的临时输出
.playwright-mcp/

# 第五部分实验的向量缓存与日志
labs/*/.cache/

# 测量与日志的临时输出
benchmarks/**/*.tmp
*.log

# 第八部分：反馈原文可能含用户数据，只提汇总
benchmarks/delivery/feedback.jsonl

# 离线 bundle 产物
dist/

# 图的预览产物（report/preview）不入库
figures/out/
